# ==============================================================================
# Sunflower Reverie - Environment Configuration Example
# ==============================================================================
# Duplicate this file as .env.local for local development:
#   cp .env.example .env.local
# Do NOT commit real credentials or secret tokens to git (.gitignore protects .env.local).

# ------------------------------------------------------------------------------
# 1. Supabase Free Tier Configuration (Required for Publishing System)
# ------------------------------------------------------------------------------
# 1. Sign up / log in to https://supabase.com and create a free project.
# 2. Go to Project Settings -> API.
# 3. Copy "Project URL" and paste as NEXT_PUBLIC_SUPABASE_URL.
# 4. Copy "anon" public API key and paste as NEXT_PUBLIC_SUPABASE_ANON_KEY.
# 5. In the SQL Editor, run:
#      - supabase/migrations/20261030_two_author_system.sql
#      - supabase/seed.sql (after inserting your two author user UUIDs)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. Canonical Website URL (for Open Graph, Twitter Cards, Sitemap, and SEO)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
